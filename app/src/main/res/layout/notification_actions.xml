<?xml version="1.0" encoding="utf-8"?>
<!-- v1.9.1 通知栏 RemoteViews(安全属性集):不用 android:tint / ?android:attr 背景(会 inflate 崩溃);
     v1.9.6 修复文字不显示:颜色改由 XML 主题属性声明(?android:attr/textColorPrimary / tint),
     SystemUI 充气时解析,自动适配通知底色深浅(华为/鸿蒙实测可用,同 v1.8.6 公式);
     代码不再注入颜色(此前注入 App 强制浅色主题的近黑色,深色通知底上不可见 = 根因)。
     行1 标题同排:[工作中][循环图标 计数] .... [倒计时(等宽)]
     行2 图标按钮:终止 | 开始/暂停 | 跳过 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_phase"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_phase_work"
            android:tint="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/cycle_cell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/notif_cycle"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_cycle"
                android:tint="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/notif_cycle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
                android:maxLines="1" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/notif_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/btn_pause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/btn_skip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:tint="?android:attr/textColorPrimary" />
    </LinearLayout>
</LinearLayout>
