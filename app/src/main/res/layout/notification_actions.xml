<?xml version="1.0" encoding="utf-8"?>
<!-- v1.8.7 自定义通知布局:标题 + [循环行:循环图标/计数 | 倒计时(等宽)] + [停止|暂停/恢复|跳过] 图标按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 循环 + 倒计时 同栏等宽 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/cycle_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/notif_cycle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_cycle"
                android:contentDescription="@string/nt_cycle" />

            <TextView
                android:id="@+id/notif_cycle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:maxLines="1" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/notif_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-light"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <!-- 图标按钮:停止 | 暂停/恢复 | 跳过 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="?android:attr/textColorPrimary"
            android:contentDescription="@string/act_stop" />

        <ImageButton
            android:id="@+id/btn_pause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="?android:attr/textColorPrimary"
            android:contentDescription="@string/act_pause" />

        <ImageButton
            android:id="@+id/btn_skip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="?android:attr/textColorPrimary"
            android:contentDescription="@string/act_skip" />
    </LinearLayout>
</LinearLayout>
