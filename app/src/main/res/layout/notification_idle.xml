<?xml version="1.0" encoding="utf-8"?>
<!-- v1.10 #48 空闲通知 RemoteViews(安全属性集,同 notification_actions.xml):
     不使用 android.widget.Space / 裸 View / ?android:attr 背景(这些会导致 RemoteViews inflate 崩溃);
     颜色由 XML 主题属性 ?android:attr/textColorPrimary 解析,自动适配通知底色深浅。
     行:[相位月亮图标][当前时钟名] .... [启动图标按钮(右侧)] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/idle_phase"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_phase_idle"
        android:tint="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/idle_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textColor="?android:attr/textColorPrimary"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageButton
        android:id="@+id/idle_start"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:background="@android:color/transparent"
        android:tint="?android:attr/textColorPrimary" />
</LinearLayout>
